FROM rust:1.94.0-bullseye

ENV DEBIAN_FRONTEND=noninteractive

# Keep installed build dependencies from the fixed base image.
# Avoid unrelated package upgrades during release builds.
RUN apt-get update \
    && apt-get install -y --no-upgrade --no-install-recommends \
        python3 \
        pkg-config \
        libfreetype6-dev \
        libfontconfig1-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*
